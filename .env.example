# =============================================================================
# Video2Skill — variables d'environnement. Copie vers .env.local et remplis.
#
# WEB APP (Vercel) : DATABASE_URL, DIRECT_URL, AUTH_*, BLOB_READ_WRITE_TOKEN,
#   GITHUB_WORKER_*, STRIPE_*, CREDITS_*, FREE_*, PUBLIC_SKILLS_*, NEXT_PUBLIC_*.
# WORKER (secrets GitHub Actions) : DATABASE_URL (pooler session),
#   BLOB_READ_WRITE_TOKEN, OPENAI_API_KEY, ANTHROPIC_API_KEY + réglages pipeline.
# Ne jamais committer de vraies clés.
# =============================================================================

# --- IA (worker) -------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Requise avec les providers par défaut (vision + synthèse + audit = anthropic).
ANTHROPIC_API_KEY=sk-ant-...

# Providers par étage : openai | anthropic
# QUALITY_PROVIDER retombe sur SYNTHESIS_PROVIDER s'il n'est pas défini.
TRANSCRIPTION_PROVIDER=openai
VISION_PROVIDER=anthropic
SYNTHESIS_PROVIDER=anthropic
QUALITY_PROVIDER=anthropic

# Modèles. La vision est appelée une fois PAR IMAGE (des dizaines par vidéo) et
# ne fait que de l'extraction JSON : c'est le poste le plus cher du pipeline et
# le moins exigeant, d'où Haiku. La synthèse et l'audit sont un appel chacun,
# là où la qualité du modèle se voit vraiment dans le résultat.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o
OPENAI_QUALITY_MODEL=gpt-4o
ANTHROPIC_VISION_MODEL=claude-haiku-4-5
ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-5
ANTHROPIC_QUALITY_MODEL=claude-sonnet-5

# --- Budget d'images (worker) ------------------------------------------------
# Le budget suit la durée : un plafond fixe faisait payer à une vidéo de 5 min
# autant d'analyse visuelle qu'à une vidéo d'une heure, pour un douzième des
# crédits. Monte FRAMES_PER_MINUTE pour plus de précision, baisse-le pour
# réduire le coût.
FRAMES_PER_MINUTE=3
MIN_VISION_FRAMES=12
MAX_VISION_FRAMES=60
# Plancher sur l'intervalle d'échantillonnage, et nombre de candidates
# extraites par emplacement pour laisser un choix au dédoublonnage.
FRAME_INTERVAL_SEC=5
FRAME_OVERSAMPLE=3
SCENE_THRESHOLD=0.3

# --- Analyse visuelle --------------------------------------------------------
VISION_CONCURRENCY=4
VISION_MAX_TOKENS=1024
VISION_IMAGE_WIDTH=1568
# Seconde passe haute résolution, uniquement sur les images que la première
# passe n'a pas su lire (Sonnet 5 / Haiku 4.5 acceptent jusqu'à 2576 px).
VISION_RETRY_UNCERTAIN=true
VISION_RETRY_IMAGE_WIDTH=2576
VISION_RETRY_MAX_FRAMES=8
JPEG_QUALITY=88
TRANSCRIPT_WINDOW_SEC=30
# Mise en cache du préfixe statique des prompts. Attention : la taille minimale
# cachable dépend du modèle (1024 tokens sur Sonnet 5, 4096 sur Haiku 4.5) —
# en dessous rien n'est mis en cache, silencieusement.
PROMPT_CACHING=true
# Sorties structurées (schéma imposé au modèle). Supprime toute une classe
# d'échecs de parsing JSON.
STRUCTURED_OUTPUTS=true

# --- Audio / transcription ---------------------------------------------------
AUDIO_CHUNK_SEC=600
# flac | wav. FLAC est sans perte et ~4x plus petit que du WAV 16 kHz mono, ce
# qui gardait les segments de 10 min dangereusement proches de la limite
# d'upload de 25 Mo.
AUDIO_CODEC=flac
TRANSCRIPTION_CONCURRENCY=4

# --- Synthèse / audit --------------------------------------------------------
TIMELINE_MAX_CHARS=600000
AUDIT_TIMELINE_MAX_CHARS=300000
SYNTHESIS_MAX_TOKENS=16384
# Au-dessus de ce score, les remarques de l'audit sont conservées mais le
# document n'est pas réécrit — la réécriture complète (~16k tokens de sortie)
# est réservée aux documents qui échouent vraiment.
QUALITY_MIN_SCORE=80

# --- OCR ---------------------------------------------------------------------
OCR_LANGS=fra+eng
OCR_CONCURRENCY=4
OCR_IMAGE_WIDTH=1600

# --- Délais / robustesse -----------------------------------------------------
API_TIMEOUT_MS=90000
API_MAX_RETRIES=2
FFMPEG_TIMEOUT_MS=900000
OCR_TIMEOUT_MS=30000
# Les étapes longues (décodage ffmpeg, OCR) peuvent tourner plusieurs minutes
# sans écrire en base. Le worker considère une ligne silencieuse comme morte et
# remet le job en file — la facture IA est alors payée deux fois. Ce battement
# maintient updatedAt à jour. Doit rester bien en dessous de
# STALE_PROCESSING_MIN (en minutes, défaut 2).
HEARTBEAT_MS=30000
STALE_PROCESSING_MIN=2

# --- Base de données (Supabase Postgres) -------------------------------------
# Supabase → ton projet → bouton « Connect » → Connection string.
# App serverless (Vercel) : pooler TRANSACTION (port 6543) + pgbouncer=true :
DATABASE_URL=postgresql://postgres.PROJET:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations (npm run db:push) + worker : pooler SESSION (port 5432 — IPv4) :
DIRECT_URL=postgresql://postgres.PROJET:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# ⚠️ N'utilise pas l'hôte direct db.PROJET.supabase.co : IPv6 uniquement sur le
# plan gratuit (inaccessible depuis GitHub Actions et beaucoup de réseaux).
# En local (docker compose) : mets la même URL locale dans les deux variables.

# --- Auth.js / Google OAuth --------------------------------------------------
# Génère le secret avec : npx auth secret
AUTH_SECRET=remplace-par-une-longue-chaine-aleatoire
AUTH_GOOGLE_ID=xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...
# Vercel définit l'URL automatiquement. Pour un autre hébergeur :
# AUTH_URL=https://ton-app.example.com

# --- Stockage blob (Vercel Blob) ---------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
MAX_UPLOAD_MB=2048

# --- Worker GitHub Actions (déclenchement automatique) -----------------------
# PAT fine-grained limité à CE repo, permission « Contents: Read and write ».
# Sans ces 2 variables : pas de réveil instantané, les jobs attendent le cron
# de secours du workflow (toutes les 6 h).
GITHUB_WORKER_TOKEN=github_pat_...
GITHUB_WORKER_REPO=Oxidoo/Video2Skill

# --- Stripe (achat de crédits) -----------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Crédits / tarification --------------------------------------------------
CREDITS_PER_MINUTE=1
SIGNUP_BONUS_CREDITS=10
# Copie visible côté client (doit être égale à CREDITS_PER_MINUTE) :
NEXT_PUBLIC_CREDITS_PER_MINUTE=1
# Export « transcription seule » : 1 crédit par N minutes (moins cher). Garde la
# copie NEXT_PUBLIC_ identique pour l'estimation de coût côté client.
TRANSCRIPT_MINUTES_PER_CREDIT=3
NEXT_PUBLIC_TRANSCRIPT_MINUTES_PER_CREDIT=3

# --- Transcription gratuite (acquisition) ------------------------------------
# Transcript YouTube sans compte : ne coûte que l'appel de transcription et sert
# d'entrée de tunnel vers le skill.md payant. Le plafond quotidien est compté
# par client via un hash salé de son adresse (jamais l'adresse elle-même).
FREE_TRANSCRIPT_ENABLED=true
FREE_TRANSCRIPT_MAX_MINUTES=20
FREE_TRANSCRIPT_PER_DAY=3
# Sel du hash anonyme. Retombe sur AUTH_SECRET s'il n'est pas défini.
ANON_SALT=une-autre-longue-chaine-aleatoire

# --- Pages skill.md publiques (SEO) ------------------------------------------
# Publication opt-in par l'utilisateur, avec confirmation des droits. Chaque
# skill publié devient une page indexable sous /skills/<slug>.
PUBLIC_SKILLS_ENABLED=true

# URL publique de l'app (redirections Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- YouTube (worker) --------------------------------------------------------
# yt-dlp a besoin d'un runtime JavaScript (Deno) pour déchiffrer les signatures
# YouTube. Sans lui il bascule sur des clients dégradés — précisément ceux que
# YouTube bloque le plus. Deno est installé par le workflow et le Dockerfile ;
# en local : curl -fsSL https://deno.land/install.sh | sh
#
# YouTube soumet les IP de datacenter (tous les runners CI, la plupart des
# hébergeurs) à un contrôle anti-bot qu'aucun réglage ne contourne de façon
# fiable. Les deux variables ci-dessous sont les seules réponses durables ;
# sans elles, l'upload de fichier reste le chemin qui marche toujours.
#
# Teste ta configuration sans créer de job :  npm run yt:check -- "<url>"
# (ou le workflow « yt-check » depuis l'onglet Actions).

# Sortie via une IP résidentielle. Le plus efficace. Les jobs « transcription
# seule » ne téléchargent que l'audio, donc le volume facturé reste faible.
# YTDLP_PROXY=http://user:pass@host:port

# Cookies au format Netscape d'un compte YouTube connecté. Exporte-les avec une
# extension « Get cookies.txt » et colle le contenu entier — un export JSON ou
# un en-tête Cookie brut sera refusé (le worker le signale dans les logs).
#
# ⚠️ Compte jetable obligatoire : YouTube peut restreindre un compte dont les
# cookies sont utilisés depuis un datacenter, et ils expirent en quelques
# semaines.
# YOUTUBE_COOKIES=

# Échappatoire : flags yt-dlp supplémentaires (po_token, etc.) sans toucher au
# code. Séparés par des espaces.
# YTDLP_EXTRA_ARGS=

# --- Worker : mode et réglages -----------------------------------------------
# WORKER_MODE=drain → traite la file puis s'arrête (GitHub Actions).
# Par défaut : boucle de polling infinie (conteneur / PC local).
WORKER_POLL_MS=5000
# WORKER_TMP_DIR=/tmp
